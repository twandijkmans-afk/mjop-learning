{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo_walk_measure_diagnostics_v1.schema.json",
  "title": "PhotoWalkMeasureDiagnosticsV1",
  "description": "Klein, lokaal diagnostiekbestand van EEN kozijnmeting (numerieke meetdiagnostiek om later te analyseren). Bevat bewust GEEN foto's, GEEN puntenwolken, GEEN absolute camerapositie/locatie en geen persoonsgegevens: alleen pixelhoeken, camera-intrinsics, aantallen, afstanden, vlakstatistieken, vlaggen en drempels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "created_utc", "platform", "data_origin", "app_build", "session_ref", "frame_id", "observation_id", "camera",
    "corners_px", "measurement", "result_flags", "algorithm", "thresholds", "user_hints_nl", "privacy"],
  "properties": {
    "contract": {"const": "photo_walk_measure_diagnostics_v1"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "created_utc": {"type": "string"},
    "platform": {"enum": ["IOS", "ANDROID", "SIMULATION"]},
    "data_origin": {"enum": ["SIMULATION", "REAL_SENSOR"]},
    "app_build": {"type": "string"},
    "session_ref": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "Eerste 12 hex-tekens van sha256(session_id); niet terug te herleiden naar het gebouw."},
    "frame_id": {"type": "string"},
    "observation_id": {"type": "string"},
    "camera": {"type": "object", "additionalProperties": false, "required": ["fx", "fy", "cx", "cy", "width", "height"],
      "properties": {"fx": {"type": "number"}, "fy": {"type": "number"}, "cx": {"type": "number"}, "cy": {"type": "number"}, "width": {"type": "integer"}, "height": {"type": "integer"}}},
    "corners_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["status", "width_m", "height_m", "area_m2", "scale_method", "level", "feedback"],
      "properties": {"status": {"enum": ["MEASURED", "DERIVED", "ESTIMATED", "UNKNOWN"]}, "width_m": {"type": ["number", "null"]}, "height_m": {"type": ["number", "null"]},
        "area_m2": {"type": ["number", "null"]}, "scale_method": {"type": "string"}, "level": {"enum": ["A", "B", "C", null]}, "feedback": {"enum": ["green", "orange", "neutral"]}}},
    "result_flags": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "detail"],
      "properties": {"code": {"type": "string"}, "severity": {"enum": ["BLOCKING", "ADVISORY"]}, "detail": {"type": ["string", "null"]}}}},
    "algorithm": {"type": "object", "description": "Numerieke diagnostiek van het meetalgoritme (zie docs/lidar_measurement_v2.md)."},
    "thresholds": {"type": "object", "description": "Gebruikte (provisional) drempels."},
    "user_hints_nl": {"type": "array", "items": {"type": "string"}},
    "privacy": {"type": "object", "additionalProperties": false,
      "required": ["images_included", "point_cloud_included", "absolute_pose_included", "location_included"],
      "properties": {"images_included": {"const": false}, "point_cloud_included": {"const": false}, "absolute_pose_included": {"const": false}, "location_included": {"const": false}}}
  }
}
