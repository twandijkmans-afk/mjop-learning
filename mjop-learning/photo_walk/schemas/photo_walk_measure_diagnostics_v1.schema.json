{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo_walk_measure_diagnostics_v1.schema.json",
  "title": "PhotoWalkMeasureDiagnosticsV1",
  "description": "Klein, lokaal diagnostiekbestand van EEN kozijnmeting (numerieke meetdiagnostiek om later te analyseren). Bevat bewust GEEN foto's, GEEN puntenwolken, GEEN absolute camerapositie/locatie en geen persoonsgegevens: alleen pixelhoeken, camera-intrinsics, aantallen, afstanden, vlakstatistieken, vlaggen en drempels. Versie 1.1.0 voegt het optionele blok `extended_diagnostics` toe (alleen getallen en labels, camera-relatief; geen locatie, geen absolute pose).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "created_utc", "platform", "data_origin", "app_build", "session_ref", "frame_id", "observation_id", "camera",
    "corners_px", "measurement", "result_flags", "algorithm", "thresholds", "user_hints_nl", "privacy"],
  "properties": {
    "contract": {"const": "photo_walk_measure_diagnostics_v1"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "created_utc": {"type": "string"},
    "platform": {"enum": ["IOS", "ANDROID", "SIMULATION"]},
    "data_origin": {"enum": ["SIMULATION", "REAL_SENSOR"]},
    "app_build": {"type": "string"},
    "session_ref": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "Eerste 12 hex-tekens van sha256(session_id); niet terug te herleiden naar het gebouw."},
    "frame_id": {"type": "string"},
    "observation_id": {"type": "string"},
    "camera": {"type": "object", "additionalProperties": false, "required": ["fx", "fy", "cx", "cy", "width", "height"],
      "properties": {"fx": {"type": "number"}, "fy": {"type": "number"}, "cx": {"type": "number"}, "cy": {"type": "number"}, "width": {"type": "integer"}, "height": {"type": "integer"}}},
    "corners_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["status", "width_m", "height_m", "area_m2", "scale_method", "level", "feedback"],
      "properties": {"status": {"enum": ["MEASURED", "DERIVED", "ESTIMATED", "UNKNOWN"]}, "width_m": {"type": ["number", "null"]}, "height_m": {"type": ["number", "null"]},
        "area_m2": {"type": ["number", "null"]}, "scale_method": {"type": "string"}, "level": {"enum": ["A", "B", "C", null]}, "feedback": {"enum": ["green", "orange", "neutral"]}}},
    "result_flags": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "detail"],
      "properties": {"code": {"type": "string"}, "severity": {"enum": ["BLOCKING", "ADVISORY"]}, "detail": {"type": ["string", "null"]}}}},
    "algorithm": {"type": "object", "description": "Numerieke diagnostiek van het meetalgoritme (zie docs/lidar_measurement_v2.md)."},
    "thresholds": {"type": "object", "description": "Gebruikte (provisional) drempels."},
    "user_hints_nl": {"type": "array", "items": {"type": "string"}},
    "extended_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "computed_after_result",
        "frames",
        "camera_gravity",
        "quad_from_corners",
        "gate_constants"
      ],
      "description": "Uitgebreide diagnostiek (spec 1.1.0); NA het resultaat berekend; heeft geen invloed op de meetuitkomst.",
      "properties": {
        "spec_version": {
          "const": "1.1.0"
        },
        "computed_after_result": {
          "const": true
        },
        "privacy_note": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "frame",
              "role",
              "used",
              "reason",
              "has_depth",
              "tracking",
              "dt_to_capture_m",
              "rot_to_capture_deg"
            ],
            "properties": {
              "frame": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "CAPTURE",
                  "SUPPORT"
                ]
              },
              "used": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "CORRELATED_OR_LIMIT",
                  "TRACKING_OR_DEPTH",
                  null
                ]
              },
              "has_depth": {
                "type": "boolean"
              },
              "tracking": {
                "type": "string"
              },
              "dt_to_capture_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rot_to_capture_deg": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "meets_baseline": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "meets_rotation": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "camera_gravity": {
          "type": "object",
          "required": [
            "pitch_deg",
            "roll_sensor_x_deg"
          ],
          "additionalProperties": false,
          "properties": {
            "pitch_deg": {
              "type": [
                "number",
                "null"
              ]
            },
            "roll_sensor_x_deg": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "quad_from_corners": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "aspect_w_over_h": {
              "type": "number"
            },
            "axes_angle_deg": {
              "type": "number"
            },
            "facing": {
              "type": "number"
            },
            "plane_normal_cam": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "planes_all": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "role",
              "count",
              "facing",
              "normal_cam",
              "centroid_cam",
              "sides_counts"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "role": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              },
              "facing": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "vertical": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "normal_cam": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              "centroid_cam": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              "sides_counts": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "sides_shares": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "gates_shadow": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "host_hypothesis",
            "gates",
            "reproduces_result_planes"
          ],
          "properties": {
            "host_hypothesis": {
              "type": [
                "object",
                "null"
              ]
            },
            "reproduces_result_planes": {
              "type": "boolean"
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_EVALUATED",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "value": {},
                  "limit": {},
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "depth_profiles": {
          "type": [
            "object",
            "null"
          ]
        },
        "glass_depth_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "framing": {
          "type": [
            "object",
            "null"
          ]
        },
        "edge_ladder_px": {
          "type": [
            "object",
            "null"
          ]
        },
        "gate_constants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "where"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "where": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "privacy": {"type": "object", "additionalProperties": false,
      "required": ["images_included", "point_cloud_included", "absolute_pose_included", "location_included"],
      "properties": {"images_included": {"const": false}, "point_cloud_included": {"const": false}, "absolute_pose_included": {"const": false}, "location_included": {"const": false}}}
  },
  "allOf": [{"if": {"required": ["extended_diagnostics"]}, "then": {"properties": {"contract_version": {"const": "1.1.0"}}}}]
}
