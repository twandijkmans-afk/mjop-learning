{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo_walk_capture_bundle_v1.schema.json",
  "title": "PhotoWalkCaptureBundleV1",
  "description": "Manifest van de ONTWIKKELBUNDEL: lokaal, standaard uitgeschakeld, alleen voor replay en kalibratie. Bevat verwijzingen naar bestanden (foto, dieptekaarten) die NIET in Git, in een PR, in CI-artifacts of in externe opslag horen. Geen locatie, geen kompas, geen absolute pose, geen gebruikers- of adresgegevens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "created_utc",
    "app_build",
    "session_ref",
    "observation_id",
    "frame_id",
    "corners_px",
    "capture_attitude",
    "frames",
    "thresholds_sha256",
    "files",
    "privacy",
    "storage"
  ],
  "properties": {
    "contract": {
      "const": "photo_walk_capture_bundle_v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "created_utc": {
      "type": "string"
    },
    "app_build": {
      "type": "string"
    },
    "session_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "observation_id": {
      "type": "string"
    },
    "frame_id": {
      "type": "string"
    },
    "corners_px": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "capture_attitude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gravity_up_in_camera",
        "note"
      ],
      "properties": {
        "gravity_up_in_camera": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "tracking",
          "intrinsics",
          "rotation_rel_row_major",
          "translation_rel_m",
          "depth"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "CAPTURE",
              "SUPPORT"
            ]
          },
          "tracking": {
            "type": "string"
          },
          "intrinsics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fx",
              "fy",
              "cx",
              "cy",
              "width",
              "height"
            ],
            "properties": {
              "fx": {
                "type": "number"
              },
              "fy": {
                "type": "number"
              },
              "cx": {
                "type": "number"
              },
              "cy": {
                "type": "number"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            }
          },
          "rotation_rel_row_major": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "number"
            }
          },
          "translation_rel_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "depth": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "file",
              "width",
              "height",
              "dtype"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "dtype": {
                "const": "float32_le"
              },
              "invalid": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "thresholds_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "DEPTH_F32_LE",
              "PHOTO_FULL_RESOLUTION"
            ]
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev_mode_only",
        "local_only",
        "full_photo_included",
        "absolute_pose_included",
        "location_included",
        "compass_included",
        "user_or_address_included"
      ],
      "properties": {
        "dev_mode_only": {
          "const": true
        },
        "local_only": {
          "const": true
        },
        "full_photo_included": {
          "type": "boolean"
        },
        "absolute_pose_included": {
          "const": false
        },
        "location_included": {
          "const": false
        },
        "compass_included": {
          "const": false
        },
        "user_or_address_included": {
          "const": false
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded_from_backup",
        "never_uploaded",
        "delete"
      ],
      "properties": {
        "excluded_from_backup": {
          "const": true
        },
        "never_uploaded": {
          "const": true
        },
        "delete": {
          "type": "string"
        }
      }
    }
  }
}
