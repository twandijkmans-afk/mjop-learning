{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "photo_walk_capture_v1.schema.json",
 "title": "PhotoWalkCaptureV1",
 "description": "Gesloten, versieerbaar capture- en meetcontract van de Photo Walk-scanner (iOS/ARKit en Android/ARCore delen dit contract). Bevat uitsluitend verwijzingen naar beelden/dieptekaarten, nooit de media zelf. Coordinatenstelsels en eenheden: zie docs/contract_and_coordinates.md. Alle hoeveelheden zijn VOORLOPIG; dit contract kent geen definitieve status, geen kosten en geen goedkeuring.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "contract_version",
  "session_id",
  "building_id",
  "facade_id",
  "platform",
  "device_model",
  "data_origin",
  "validation_level",
  "sensor_capabilities",
  "coordinate_system",
  "camera_intrinsics",
  "camera_poses",
  "capture_timestamp",
  "image_refs",
  "depth_refs",
  "tracking_quality",
  "measurement_mode",
  "scale_method",
  "scale_evidence",
  "measurement_method_version",
  "processing_version",
  "thresholds",
  "references",
  "observations",
  "objects",
  "coverage",
  "summary",
  "privacy",
  "invariants"
 ],
 "definitions": {
  "decimal": {
   "type": "string",
   "pattern": "^[0-9]+(\\.[0-9]+)?$"
  },
  "decimal_or_null": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]+(\\.[0-9]+)?$"
  },
  "point2": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "point3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "flag": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "severity",
    "detail",
    "instruction_nl"
   ],
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-Z_]+$"
    },
    "severity": {
     "enum": [
      "BLOCKING",
      "ADVISORY"
     ]
    },
    "detail": {
     "type": [
      "string",
      "null"
     ]
    },
    "instruction_nl": {
     "type": "string"
    }
   }
  },
  "corner_pixels": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "observation_ref",
    "frame_id",
    "unit",
    "points",
    "original_points",
    "revisions"
   ],
   "properties": {
    "observation_ref": {
     "type": "string"
    },
    "frame_id": {
     "type": "string"
    },
    "unit": {
     "const": "px"
    },
    "points": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/point2"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "original_points": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/point2"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "revisions": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "revision",
       "corner_index",
       "corner_name",
       "before_px",
       "after_px",
       "edited_by",
       "edited_at",
       "reason"
      ],
      "properties": {
       "revision": {
        "type": "integer",
        "minimum": 1
       },
       "corner_index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
       },
       "corner_name": {
        "enum": [
         "TOP_LEFT",
         "TOP_RIGHT",
         "BOTTOM_RIGHT",
         "BOTTOM_LEFT"
        ]
       },
       "before_px": {
        "$ref": "#/definitions/point2"
       },
       "after_px": {
        "$ref": "#/definitions/point2"
       },
       "edited_by": {
        "type": "string"
       },
       "edited_at": {
        "type": "string"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "object": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "provisional_object_id",
    "observation_refs",
    "frame_type",
    "parts",
    "detection_method",
    "corner_sources",
    "corner_order",
    "outer_corner_coordinates",
    "corner_pixels",
    "outer_width_m",
    "outer_height_m",
    "gross_area_m2",
    "gross_area_m2_presented",
    "dimension_status",
    "measurement_uncertainty",
    "measurement_source",
    "review_required",
    "quality_flags",
    "next_steps_nl",
    "quantity_layer",
    "approval_state"
   ],
   "properties": {
    "provisional_object_id": {
     "type": "string",
     "pattern": "^PROV-"
    },
    "observation_refs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "frame_type": {
     "enum": [
      "FRAME",
      "FRAME_WITH_DOOR",
      "DOOR",
      "UNKNOWN"
     ]
    },
    "parts": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "fixed_parts",
      "movable_parts",
      "note"
     ],
     "properties": {
      "fixed_parts": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      "movable_parts": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      "note": {
       "type": "string"
      }
     }
    },
    "detection_method": {
     "enum": [
      "SEMI_AUTOMATIC",
      "AUTOMATIC_CANDIDATE"
     ]
    },
    "corner_sources": {
     "type": "array",
     "items": {
      "enum": [
       "MANUAL",
       "AUTO_DETECTED_UNCONFIRMED",
       "AUTO_DETECTED_CONFIRMED",
       "MANUAL_CORRECTED"
      ]
     }
    },
    "corner_order": {
     "const": [
      "TOP_LEFT",
      "TOP_RIGHT",
      "BOTTOM_RIGHT",
      "BOTTOM_LEFT"
     ]
    },
    "outer_corner_coordinates": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "coordinate_system",
        "unit",
        "points"
       ],
       "properties": {
        "coordinate_system": {
         "const": "WORLD_M_Y_UP"
        },
        "unit": {
         "const": "m"
        },
        "points": {
         "type": "array",
         "items": {
          "$ref": "#/definitions/point3"
         },
         "minItems": 4,
         "maxItems": 4
        }
       }
      }
     ]
    },
    "corner_pixels": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/corner_pixels"
     },
     "minItems": 1
    },
    "outer_width_m": {
     "$ref": "#/definitions/decimal_or_null"
    },
    "outer_height_m": {
     "$ref": "#/definitions/decimal_or_null"
    },
    "gross_area_m2": {
     "$ref": "#/definitions/decimal_or_null"
    },
    "gross_area_m2_presented": {
     "$ref": "#/definitions/decimal_or_null"
    },
    "dimension_status": {
     "enum": [
      "MEASURED",
      "DERIVED",
      "ESTIMATED",
      "UNKNOWN"
     ]
    },
    "measurement_uncertainty": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "model",
        "validated",
        "samples",
        "width_sigma_m",
        "height_sigma_m",
        "area_sigma_m2",
        "note"
       ],
       "properties": {
        "model": {
         "type": "string"
        },
        "validated": {
         "const": false
        },
        "samples": {
         "type": "integer"
        },
        "width_sigma_m": {
         "$ref": "#/definitions/decimal"
        },
        "height_sigma_m": {
         "$ref": "#/definitions/decimal"
        },
        "area_sigma_m2": {
         "$ref": "#/definitions/decimal"
        },
        "note": {
         "type": "string"
        }
       }
      }
     ]
    },
    "measurement_source": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "level",
      "scale_method",
      "views",
      "scale_evidence"
     ],
     "properties": {
      "level": {
       "enum": [
        "A",
        "B",
        "C",
        null
       ]
      },
      "scale_method": {
       "enum": [
        "LIDAR_DEPTH_PLANE",
        "LIDAR_DEPTH_MULTI_FRAME",
        "AR_TRIANGULATION_VIO",
        "REFERENCE_DISTANCE",
        "NONE"
       ]
      },
      "views": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "scale_evidence": {
       "type": "object"
      }
     }
    },
    "review_required": {
     "type": "boolean"
    },
    "quality_flags": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/flag"
     }
    },
    "next_steps_nl": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "quantity_layer": {
     "const": "PROVISIONAL"
    },
    "approval_state": {
     "const": "PENDING_HUMAN_APPROVAL"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "dimension_status": {
        "const": "UNKNOWN"
       }
      }
     },
     "then": {
      "properties": {
       "outer_width_m": {
        "type": "null"
       },
       "outer_height_m": {
        "type": "null"
       },
       "gross_area_m2": {
        "type": "null"
       },
       "measurement_uncertainty": {
        "type": "null"
       },
       "review_required": {
        "const": true
       }
      }
     },
     "else": {
      "properties": {
       "outer_width_m": {
        "type": "string"
       },
       "outer_height_m": {
        "type": "string"
       },
       "gross_area_m2": {
        "type": "string"
       },
       "measurement_uncertainty": {
        "type": "object"
       }
      }
     }
    }
   ]
  }
 },
 "properties": {
  "contract": {
   "const": "photo_walk_capture_v1"
  },
  "contract_version": {
   "type": "string",
   "pattern": "^1\\.[0-9]+\\.[0-9]+$"
  },
  "session_id": {
   "type": "string",
   "minLength": 1
  },
  "building_id": {
   "type": "string",
   "minLength": 1
  },
  "facade_id": {
   "type": "string",
   "minLength": 1
  },
  "platform": {
   "enum": [
    "IOS",
    "ANDROID",
    "SIMULATION"
   ]
  },
  "device_model": {
   "type": "string"
  },
  "data_origin": {
   "enum": [
    "SIMULATION",
    "REAL_SENSOR"
   ]
  },
  "validation_level": {
   "enum": [
    "BUILT",
    "COMPILED",
    "SIMULATED",
    "REAL_SENSOR_UNVALIDATED",
    "DEVICE_VALIDATED"
   ],
   "description": "Hoogste bewezen niveau van de code die deze data produceerde. DEVICE_VALIDATED vereist vergelijking met referentiemetingen op een fysiek toestel (nog niet uitgevoerd)."
  },
  "sensor_capabilities": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "lidar",
    "scene_depth",
    "depth_api",
    "ar_world_tracking",
    "metric_tracking",
    "camera_intrinsics_available"
   ],
   "properties": {
    "lidar": {
     "type": "boolean"
    },
    "scene_depth": {
     "type": "boolean"
    },
    "depth_api": {
     "type": "boolean"
    },
    "ar_world_tracking": {
     "type": "boolean"
    },
    "metric_tracking": {
     "type": "boolean"
    },
    "camera_intrinsics_available": {
     "type": "boolean"
    }
   }
  },
  "coordinate_system": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pixel",
    "camera",
    "world",
    "pose",
    "depth",
    "units"
   ],
   "properties": {
    "pixel": {
     "const": "origin top-left corner of top-left pixel; u right, v down; unit px"
    },
    "camera": {
     "const": "OpenCV: x right, y down, z forward; unit m"
    },
    "world": {
     "const": "right-handed, Y up (gravity aligned), unit m; origin = AR session start"
    },
    "pose": {
     "const": "camera_to_world 4x4 row-major as 16 numbers; x_world = R x_camera + t"
    },
    "depth": {
     "const": "depth_z: distance along the optical axis in m; 0/NaN invalid"
    },
    "units": {
     "const": "m, px, m2, degrees"
    }
   }
  },
  "camera_intrinsics": {
   "type": "array",
   "minItems": 0,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "intrinsics_id",
     "fx",
     "fy",
     "cx",
     "cy",
     "width",
     "height"
    ],
    "properties": {
     "intrinsics_id": {
      "type": "string"
     },
     "fx": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "fy": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "cx": {
      "type": "number"
     },
     "cy": {
      "type": "number"
     },
     "width": {
      "type": "integer",
      "minimum": 1
     },
     "height": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "camera_poses": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "frame_id",
     "intrinsics_id",
     "camera_to_world",
     "pose_valid"
    ],
    "properties": {
     "frame_id": {
      "type": "string"
     },
     "intrinsics_id": {
      "type": "string"
     },
     "pose_valid": {
      "type": "boolean"
     },
     "camera_to_world": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 16,
      "maxItems": 16
     }
    }
   }
  },
  "capture_timestamp": {
   "type": "string"
  },
  "image_refs": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "frame_id",
     "ref",
     "timestamp"
    ],
    "properties": {
     "frame_id": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     },
     "ref": {
      "type": "string",
      "pattern": "^local://",
      "description": "Opake lokale verwijzing; nooit een pad naar of upload van de afbeelding."
     }
    }
   }
  },
  "depth_refs": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "frame_id",
     "ref",
     "width",
     "height",
     "unit",
     "convention"
    ],
    "properties": {
     "frame_id": {
      "type": "string"
     },
     "ref": {
      "type": "string",
      "pattern": "^local://"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     },
     "unit": {
      "const": "m"
     },
     "convention": {
      "const": "depth_z"
     }
    }
   }
  },
  "tracking_quality": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "frame_id",
     "state"
    ],
    "properties": {
     "frame_id": {
      "type": "string"
     },
     "state": {
      "enum": [
       "NORMAL",
       "LIMITED_INITIALIZING",
       "LIMITED_EXCESSIVE_MOTION",
       "LIMITED_INSUFFICIENT_FEATURES",
       "LIMITED_RELOCALIZING",
       "NOT_AVAILABLE"
      ]
     }
    }
   }
  },
  "measurement_mode": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "primary_level",
    "mode",
    "fallback_chain",
    "reason"
   ],
   "properties": {
    "primary_level": {
     "enum": [
      "A",
      "B",
      "C"
     ]
    },
    "mode": {
     "type": "string"
    },
    "fallback_chain": {
     "type": "array",
     "items": {
      "enum": [
       "A",
       "B",
       "C"
      ]
     }
    },
    "reason": {
     "type": "string"
    }
   }
  },
  "scale_method": {
   "enum": [
    "LIDAR_DEPTH_PLANE",
    "LIDAR_DEPTH_MULTI_FRAME",
    "AR_TRIANGULATION_VIO",
    "REFERENCE_DISTANCE",
    "MIXED",
    "NONE"
   ]
  },
  "scale_evidence": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "measurement_method_version": {
   "type": "string"
  },
  "processing_version": {
   "type": "string"
  },
  "thresholds": {
   "type": "object",
   "required": [
    "threshold_status"
   ],
   "properties": {
    "threshold_status": {
     "const": "PROVISIONAL_UNVALIDATED"
    }
   }
  },
  "references": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reference_id",
     "frame_id",
     "p1_px",
     "p2_px",
     "distance_m",
     "distance_sigma_m",
     "plane_id",
     "entered_by"
    ],
    "properties": {
     "reference_id": {
      "type": "string"
     },
     "frame_id": {
      "type": "string"
     },
     "p1_px": {
      "$ref": "#/definitions/point2"
     },
     "p2_px": {
      "$ref": "#/definitions/point2"
     },
     "distance_m": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "distance_sigma_m": {
      "type": [
       "number",
       "null"
      ]
     },
     "plane_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "entered_by": {
      "type": "string"
     },
     "anchor_px": {
      "type": [
       "array",
       "null"
      ]
     },
     "anchor_observation_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "enum": [
       "MEASURED_WITH_TOOL",
       "KNOWN_FROM_DRAWING",
       "USER_ESTIMATE"
      ],
      "description": "Herkomst van de referentieafstand. USER_ESTIMATE = geschat, niet gemeten (geeft nooit DERIVED). Optioneel."
     }
    }
   }
  },
  "observations": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "observation_id",
     "frame_id",
     "corner_source",
     "obstruction_reported"
    ],
    "properties": {
     "observation_id": {
      "type": "string"
     },
     "frame_id": {
      "type": "string"
     },
     "obstruction_reported": {
      "type": "boolean"
     },
     "corner_source": {
      "enum": [
       "MANUAL",
       "AUTO_DETECTED_UNCONFIRMED",
       "AUTO_DETECTED_CONFIRMED",
       "MANUAL_CORRECTED"
      ]
     },
     "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "detector",
       "score",
       "status"
      ],
      "properties": {
       "detector": {
        "type": "string"
       },
       "score": {
        "type": "number"
       },
       "status": {
        "const": "CANDIDATE_UNVERIFIED"
       }
      }
     }
    }
   }
  },
  "objects": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/object"
   }
  },
  "coverage": {
   "type": [
    "object",
    "null"
   ]
  },
  "summary": {
   "type": "object",
   "required": [
    "object_count",
    "by_status",
    "review_required",
    "note"
   ]
  },
  "scan_label": {
   "enum": [
    "SEMI_AUTOMATIC",
    "AUTOMATIC_CANDIDATES_HUMAN_CONFIRMED",
    "AUTOMATIC_UNREVIEWED",
    "NO_OBSERVATIONS"
   ]
  },
  "privacy": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "raw_media_included",
    "external_calls",
    "location_stored",
    "processing",
    "retention_proposal"
   ],
   "properties": {
    "raw_media_included": {
     "const": false
    },
    "external_calls": {
     "const": 0
    },
    "location_stored": {
     "const": false
    },
    "processing": {
     "const": "LOCAL_ONLY"
    },
    "retention_proposal": {
     "type": "string"
    }
   }
  },
  "invariants": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "quantity_layer",
    "approval_state",
    "is_final",
    "human_decision_registered",
    "approvals_simulated",
    "cost_link",
    "kengetal_link",
    "price_link",
    "external_vision_calls",
    "images_uploaded"
   ],
   "properties": {
    "quantity_layer": {
     "const": "PROVISIONAL"
    },
    "approval_state": {
     "const": "PENDING_HUMAN_APPROVAL"
    },
    "is_final": {
     "const": false
    },
    "human_decision_registered": {
     "const": false
    },
