{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quantity_resolution_record.schema.json",
  "title": "QuantityResolutionStore",
  "description": "Append-only menselijke beslissingen over een hoeveelheid per (building_id, subject_id), zelfde patroon als human_decision_record: nooit overschrijven, 'supersedes' naar het vorige record, per onderwerp hoogstens één ACTIVE. De waarde komt altijd letterlijk uit één evidence-record (ACCEPT_EVIDENCE) of uit een MANUAL-evidence (USER_VALUE); middelen of combineren is niet mogelijk. Geen score- of confidencevelden.",
  "type": "object",
  "definitions": {
    "record": {
      "type": "object",
      "properties": {
        "resolution_id": {
          "type": "string",
          "pattern": "^QRR-[0-9]{5}$"
        },
        "building_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "pattern": "^QS-[0-9a-f]{16}$"
        },
        "decision": {
          "enum": [
            "ACCEPT_EVIDENCE",
            "USER_VALUE",
            "UNKNOWN"
          ]
        },
        "selected_evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^QE-[0-9a-f]{16}$"
        },
        "manual_evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^QE-[0-9a-f]{16}$"
        },
        "resolved_value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "resolved_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "considered_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^QE-[0-9a-f]{16}$"
          }
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "reviewer_id": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_type": {
              "const": "human"
            }
          },
          "required": [
            "reviewer_id",
            "reviewer_type"
          ],
          "additionalProperties": false
        },
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "input_hashes": {
          "type": "object",
          "properties": {
            "considered_evidence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "considered_evidence_sha256"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^QRR-[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "REVIEW_REQUIRED"
          ]
        }
      },
      "required": [
        "resolution_id",
        "building_id",
        "subject_id",
        "decision",
        "selected_evidence_id",
        "manual_evidence_id",
        "resolved_value",
        "resolved_unit",
        "considered_evidence_ids",
        "decision_reason",
        "reviewer",
        "reviewed_at",
        "rule_version",
        "input_hashes",
        "notes",
        "supersedes",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "store_version": {
      "const": "quantity_resolution_v1"
    },
    "description": {
      "type": "string"
    },
    "append_only": {
      "const": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "required": [
    "store_version",
    "append_only",
    "records"
  ],
  "additionalProperties": false
}
