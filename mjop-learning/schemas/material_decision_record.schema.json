{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "material_decision_record.schema.json",
  "title": "MaterialDecisionStore",
  "description": "Append-only opslag van menselijke materiaalbesluiten voor EXACTE observations (scripts/record_material_decision.py, docs/comparability_rules_v1.md punt 9). Geen documentbrede scope, geen afleiding: elk record geldt voor precies één observation_id en alleen zolang de bronobservation byte-gelijk is aan wat de mens beoordeelde. Geen score- of confidencevelden.",
  "type": "object",
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_id": { "type": "string", "pattern": "^MDR-[0-9]{5}$" },
    "record": {
      "type": "object",
      "properties": {
        "decision_id": { "$ref": "#/definitions/decision_id" },
        "observation_id": { "type": "string", "pattern": "^PO-DOC-[0-9]{3,}-(P[0-9]{3}-L[0-9]{3}|S[0-9]{2}-R[0-9]{4})$" },
        "document_id": { "type": "string", "pattern": "^DOC-[0-9]{3,}$" },
        "element_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "const": "EXACT_OBSERVATION" },
        "material": {
          "type": "object",
          "properties": {
            "original_value": { "type": "string", "minLength": 1 },
            "normalized_value": { "type": "string", "minLength": 1 }
          },
          "required": ["original_value", "normalized_value"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "description": "Exact de bronwaarden die de mens beoordeelde (letterlijk gelijk aan de observation).",
          "properties": {
            "element_description_original": { "type": "string" },
            "action_text_original": { "type": "string" },
            "unit_original": { "type": "string" },
            "material_token_in_element_text": { "type": "string" },
            "source_text": { "type": ["string", "null"] },
            "page": { "type": ["integer", "null"] },
            "line": { "type": ["integer", "null"] },
            "sheet": { "type": ["string", "null"] },
            "row": { "type": ["integer", "null"] }
          },
          "required": ["element_description_original", "action_text_original", "unit_original",
                       "material_token_in_element_text", "source_text", "page", "line"],
          "additionalProperties": false
        },
        "source_observation_sha256": { "$ref": "#/definitions/sha256" },
        "source_document_sha256": { "$ref": "#/definitions/sha256" },
        "decision_reason": { "type": "string", "minLength": 1 },
        "reviewer": {
          "type": "object",
          "properties": {
            "reviewer_id": { "type": "string", "minLength": 1 },
            "reviewer_type": { "type": "string", "const": "human" }
          },
          "required": ["reviewer_id", "reviewer_type"],
          "additionalProperties": false
        },
        "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUPERSEDED"] },
        "supersedes": { "oneOf": [{ "$ref": "#/definitions/decision_id" }, { "type": "null" }] }
      },
      "required": ["decision_id", "observation_id", "document_id", "element_id", "scope", "material", "evidence",
                   "source_observation_sha256", "source_document_sha256", "decision_reason", "reviewer",
                   "reviewed_at", "status", "supersedes"],
      "additionalProperties": false
    }
  },
  "properties": {
    "store_version": { "type": "string", "const": "material_decisions_v1" },
    "description": { "type": "string" },
    "append_only": { "type": "boolean", "const": true },
    "records": { "type": "array", "items": { "$ref": "#/definitions/record" } }
  },
  "required": ["store_version", "append_only", "records"],
  "additionalProperties": false
}
