{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crosswalk_decision_record.schema.json",
  "title": "CrosswalkDecisionStore",
  "description": "Append-only menselijke verificatie van crosswalk-/onderwerpmappings (scripts/crosswalk.py). VERIFY geldt alleen zolang proposal_sha256 gelijk is aan het huidige voorstel.",
  "type": "object",
  "definitions": {
    "record": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^XWD-[0-9]{5}$"
        },
        "mapping_id": {
          "type": "string",
          "pattern": "^(HSM|XW|XQ)-"
        },
        "decision": {
          "enum": [
            "VERIFY",
            "REJECT"
          ]
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "reviewer_id": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_type": {
              "const": "human"
            }
          },
          "required": [
            "reviewer_id",
            "reviewer_type"
          ],
          "additionalProperties": false
        },
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "rule_version": {
          "type": "string"
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^XWD-[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "REVIEW_REQUIRED"
          ]
        }
      },
      "required": [
        "decision_id",
        "mapping_id",
        "decision",
        "proposal_sha256",
        "decision_reason",
        "reviewer",
        "reviewed_at",
        "rule_version",
        "supersedes",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "store_version": {
      "const": "crosswalk_decision_v1"
    },
    "description": {
      "type": "string"
    },
    "append_only": {
      "const": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "required": [
    "store_version",
    "append_only",
    "records"
  ],
  "additionalProperties": false
}
