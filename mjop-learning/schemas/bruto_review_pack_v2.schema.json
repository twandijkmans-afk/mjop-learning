{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bruto_review_pack_v2.schema.json",
  "title": "BrutoReviewPackV2",
  "description": "Machineleesbare review-export van Quantity Review & Triage v1. Voorlopig en niet vrijgegeven: geen besluit, geen CONFIRMED, geen FI-id, geen definitief totaal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "pack_id",
    "input_sha256",
    "calibration",
    "invariants",
    "summary",
    "objects",
    "work_queue",
    "groups",
    "scenarios",
    "baseline_state",
    "notes"
  ],
  "properties": {
    "contract_version": {
      "const": "bruto_review_pack_v2"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^BRP-[0-9a-f]{16}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration": {
      "type": "object",
      "required": [
        "declared_status",
        "effective_status",
        "conservative_fallback",
        "problems",
        "parameters"
      ]
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_state",
        "usable_for_mjop",
        "decisions_registered",
        "approvals_simulated",
        "fi_ids_created",
        "confirmed_output",
        "group_release_executed",
        "ai_confidence_used_in_decision",
        "final_building_total",
        "network_used",
        "clicks_register_decisions"
      ],
      "properties": {
        "release_state": {
          "const": "NOT_RELEASED"
        },
        "usable_for_mjop": {
          "const": false
        },
        "decisions_registered": {
          "const": false
        },
        "approvals_simulated": {
          "const": false
        },
        "fi_ids_created": {
          "const": false
        },
        "confirmed_output": {
          "const": false
        },
        "group_release_executed": {
          "const": false
        },
        "ai_confidence_used_in_decision": {
          "const": false
        },
        "final_building_total": {
          "const": null
        },
        "network_used": {
          "const": false
        },
        "clicks_register_decisions": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "provisional_object_id",
          "object_origin",
          "object_category",
          "type_id",
          "quantity",
          "observations",
          "identity_evidence",
          "dimension",
          "identity_axis",
          "dimension_axis",
          "overall_class",
          "work_state",
          "review_priority",
          "review_reasons",
          "contradictions",
          "effect_on_provisional_quantities",
          "ai_confidence",
          "info_flags",
          "released"
        ],
        "properties": {
          "released": {
            "const": false
          },
          "overall_class": {
            "enum": [
              "CLEAN_PROVISIONAL",
              "REVIEW_REQUIRED",
              "INSUFFICIENT_EVIDENCE",
              "CONFLICT"
            ]
          },
          "work_state": {
            "enum": [
              "AUTO_PROVISIONAL",
              "INDIVIDUAL_REVIEW",
              "BLOCKED",
              "READY_FOR_GROUP_REVIEW"
            ]
          },
          "ai_confidence": {
            "type": "object",
            "required": [
              "value",
              "used_in_decision",
              "calibrated"
            ],
            "properties": {
              "used_in_decision": {
                "const": false
              },
              "calibrated": {
                "const": false
              }
            }
          },
          "object_id": {},
          "provisional_object_id": {},
          "object_origin": {},
          "object_category": {},
          "type_id": {},
          "quantity": {},
          "observations": {},
          "identity_evidence": {},
          "dimension": {},
          "identity_axis": {},
          "dimension_axis": {},
          "review_priority": {},
          "review_reasons": {},
          "contradictions": {},
          "effect_on_provisional_quantities": {},
          "info_flags": {}
        }
      }
    },
    "work_queue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "member_object_ids",
          "status",
          "release_executed",
          "audit_sample_object_ids",
          "content_sha256"
        ],
        "properties": {
          "status": {
            "const": "PREPARED_NOT_RELEASED"
          },
          "release_executed": {
            "const": false
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "kind",
          "additive",
          "is_final_quantity",
          "overlap_group",
          "object_ids",
          "statement"
        ],
        "properties": {
          "additive": {
            "const": false
          },
          "is_final_quantity": {
            "const": false
          }
        }
      }
    },
    "baseline_state": {
      "$ref": "bruto_quantity_state_v2.schema.json"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
