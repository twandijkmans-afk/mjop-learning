{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "bruto_frame_type_v2.schema.json",
 "title": "BrutoFrameTypeV2",
 "description": "Kozijn- of deurtype voor Bruto Quantity Model v2. Een type is een groepering en referentie, GEEN fysieke instance en geen FI-id. Referentiematen zijn betrouwbaar (MEASURED/DRAWING_DERIVED) of ontbreken; afwijkende varianten hebben een eigen maat.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_version",
  "type_id",
  "description",
  "type_classification",
  "object_category",
  "material",
  "material_basis",
  "reference_dimensions",
  "variants",
  "sources",
  "observation_refs",
  "is_physical_instance",
  "fi_ids",
  "status"
 ],
 "properties": {
  "contract_version": {
   "const": "bruto_frame_type_v2"
  },
  "type_id": {
   "type": "string",
   "pattern": "^BQT-[A-Z0-9][A-Z0-9-]*$"
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "type_classification": {
   "enum": [
    "FRAME_FIXED",
    "FRAME_CASEMENT",
    "FRAME_TURN_TILT",
    "FRAME_COMBINATION",
    "DOOR_ENTRANCE",
    "DOOR_GARDEN",
    "DOOR_BALCONY_WITH_FRAME",
    "OTHER",
    "UNKNOWN"
   ]
  },
  "object_category": {
   "enum": [
    "FRAME",
    "FRAME_WITH_DOOR",
    "DOOR"
   ]
  },
  "material": {
   "enum": [
    "WOOD",
    "PVC",
    "ALUMINIUM",
    "STEEL",
    "OTHER",
    "UNKNOWN"
   ]
  },
  "material_basis": {
   "type": [
    "string",
    "null"
   ],
   "description": "Herkomst van het materiaal; verplicht als materiaal bekend is."
  },
  "reference_dimensions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reference_id",
     "dimension"
    ],
    "properties": {
     "reference_id": {
      "type": "string",
      "minLength": 1
     },
     "dimension": {
      "$ref": "bruto_dimension_v2.schema.json"
     }
    }
   }
  },
  "variants": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "variant_id",
     "description",
     "dimension"
    ],
    "properties": {
     "variant_id": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string"
     },
     "dimension": {
      "$ref": "bruto_dimension_v2.schema.json"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "$ref": "bruto_dimension_v2.schema.json#/definitions/source"
   }
  },
  "observation_refs": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "description": "Relatie met foto-observaties; geen identiteitsbewijs."
  },
  "is_physical_instance": {
   "const": false
  },
  "fi_ids": {
   "type": "array",
   "maxItems": 0,
   "description": "Een type krijgt nooit een FI-id."
  },
  "status": {
   "enum": [
    "DRAFT",
    "PROPOSED"
   ]
  }
 }
}
