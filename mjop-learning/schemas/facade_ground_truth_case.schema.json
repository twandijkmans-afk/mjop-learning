{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "facade_ground_truth_case.schema.json",
  "title": "Facade ground truth case (PoC v1)",
  "description": "Eén testcase (pand/woning) voor de Ground Truth Quantity PoC. Ground truth = een echte fysieke meting of een maatvaste tekening; nooit een schatting, nooit een historische MJOP-hoeveelheid, nooit modeloutput. Geen confidence score.",
  "type": "object",
  "required": ["case_id", "bag_pand_id", "addresses", "selection_reason", "geometric_definition", "scopes"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string", "pattern": "^GT-[A-Z]{3}-[0-9]{2}$"},
    "bag_pand_id": {"type": "string", "pattern": "^[0-9]{16}$"},
    "addresses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selection_reason": {"type": "string"},
    "geometric_definition": {"const": "PROJECTED_OPENING_BBOX_AREA_IN_FACADE_PLANE"},
    "notes": {"type": ["string", "null"]},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/scope"}
    }
  },
  "definitions": {
    "status": {"enum": ["MISSING", "PARTIAL", "MEASURED", "DRAWING_DERIVED"]},
    "level": {"enum": ["BG", "1e", "kap"]},
    "object_type": {"enum": ["window_frame", "door", "garage_door", "dormer", "facade_panel"]},
    "image_ref": {
      "type": "object",
      "required": ["image_id", "source_type", "viewpoint", "path"],
      "additionalProperties": false,
      "properties": {
        "image_id": {"type": "string"},
        "source_type": {"enum": ["PANORAMA_AMSTERDAM", "RESIDENT_PHOTO", "DRAWING"]},
        "viewpoint": {"enum": ["FRONTAL", "OBLIQUE", "ELEVATION_DRAWING"]},
        "path": {"type": ["string", "null"], "description": "repo-pad of panorama-URL; null zolang de foto ontbreekt"},
        "captured_at": {"type": ["string", "null"]},
        "camera_distance_m": {"type": ["number", "null"]},
        "status": {"enum": ["MISSING", "PRESENT"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "gt_object": {
      "type": "object",
      "required": ["object_id", "type", "level", "order_from_left", "width_m", "height_m", "count", "unit",
                   "measurement_source", "provenance", "measured_by", "measured_at"],
      "additionalProperties": false,
      "properties": {
        "object_id": {"type": "string"},
        "type": {"$ref": "#/definitions/object_type"},
        "level": {"$ref": "#/definitions/level"},
        "order_from_left": {"type": "integer", "minimum": 1, "description": "volgorde op deze gevel van links naar rechts, binnen dezelfde laag"},
        "width_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$", "description": "buitenwerks kozijn, buitenkant tot buitenkant (Decimal als string)"},
        "height_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$", "description": "bovenkant kozijn tot onderkant onderdorpel, excl. stenen raamdorpel"},
        "count": {"type": "integer", "minimum": 1},
        "unit": {"const": "m"},
        "includes_panel_in_frame": {"type": ["boolean", "null"]},
        "visible_in_images": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "image_id -> is het object (grotendeels) zichtbaar in dat beeld; door een mens ingevuld"},
        "measurement_source": {"enum": ["PHYSICAL_TAPE", "PHYSICAL_LASER", "DRAWING"]},
        "provenance": {"type": "string", "description": "bv. 'handmeting 2026-10-12, rolmaat' of tekeningnummer + schaal"},
        "measured_by": {"type": "string"},
        "measured_at": {"type": "string"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "manual_match": {
      "type": "object",
      "required": ["model_element_id", "object_id"],
      "additionalProperties": false,
      "properties": {
        "model_element_id": {"type": "string"},
        "object_id": {"type": ["string", "null"], "description": "null = bevestigd false positive"},
        "decided_by": {"type": "string"},
        "cause": {"enum": ["DETECTION_ERROR", "MEASUREMENT_PROJECTION_ERROR", "COVERAGE_OCCLUSION",
                           "SEMANTIC_DEFINITION_DIFFERENCE", "UNDETERMINED"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "scope": {
      "type": "object",
      "required": ["scope_id", "facade_side", "description", "ground_truth_status", "images", "measured_objects", "model_source"],
      "additionalProperties": false,
      "properties": {
        "scope_id": {"type": "string"},
        "facade_side": {"enum": ["FRONT", "REAR", "GABLE"]},
        "description": {"type": "string"},
        "wall_ref": {"type": ["object", "null"], "description": "3D BAG-wand (bag_pand_id + wall_index) indien van toepassing"},
        "ground_truth_status": {"$ref": "#/definitions/status"},
        "images": {"type": "array", "items": {"$ref": "#/definitions/image_ref"}},
        "measured_objects": {"type": "array", "items": {"$ref": "#/definitions/gt_object"}},
        "objects_to_measure": {"type": "array", "items": {"type": "string"}, "description": "meetverzoek (GEEN ground truth)"},
        "model_source": {
          "type": "object",
          "required": ["source_type", "status"],
          "additionalProperties": false,
          "properties": {
            "source_type": {"enum": ["PANORAMA_V2_COMMITTED", "RESIDENT_PHOTO_DETECTION"]},
            "status": {"enum": ["MISSING", "PRESENT"]},
            "ref": {"type": ["string", "null"]},
            "wall_index": {"type": ["integer", "null"]}
          }
        },
        "manual_matches": {"type": "array", "items": {"$ref": "#/definitions/manual_match"}}
      }
    }
  }
}
