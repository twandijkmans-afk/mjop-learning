{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo_consent_record.schema.json",
  "title": "PhotoConsentRecord",
  "description": "Menselijke toestemming en privacycontrole voor het versturen van EXACT genoemde afgeleide beelden naar EEN externe visionprovider. Zonder geldig record weigert elke externe adapter (fail-closed). Records horen in privé-opslag, niet in de publieke repository. In deze PoC bestaan geen echte records; alleen synthetische testrecords. Het budget (max_calls, max_output_tokens) geldt als TOTAAL over alle processen en wordt afgedwongen door een persistent grootboek.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consent_id",
    "provider",
    "purpose",
    "photos",
    "derivative_policy",
    "valid_until",
    "budget",
    "terms_verified",
    "approved_by",
    "approved_at",
    "allowed_models",
    "authorization"
  ],
  "properties": {
    "consent_id": {
      "type": "string",
      "pattern": "^PCON-[0-9]{5}$"
    },
    "provider": {
      "enum": [
        "anthropic"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "photo_id",
          "derivative_sha256",
          "privacy_check"
        ],
        "properties": {
          "photo_id": {
            "type": "string"
          },
          "derivative_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "privacy_check": {
            "enum": [
              "ALLOW",
              "ALLOW_WITH_REDACTION",
              "DENY"
            ]
          },
          "redaction_applied": {
            "type": "boolean"
          },
          "privacy_notes": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "derivative_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exif_stripped",
        "max_long_edge_px",
        "media_type",
        "max_file_bytes"
      ],
      "properties": {
        "exif_stripped": {
          "const": true
        },
        "max_long_edge_px": {
          "type": "integer",
          "minimum": 64,
          "description": "Moet door de gebruiker uit de actuele providerdocumentatie worden overgenomen; er is geen standaardwaarde."
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp"
          ]
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000000,
          "description": "Harde bovengrens op het werkelijke aantal bytes van de afgeleide kopie; uit de actuele providerdocumentatie over te nemen."
        }
      }
    },
    "valid_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "max_output_tokens"
      ],
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terms_verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_terms_checked",
        "training_use_checked",
        "data_processing_agreement_checked",
        "checked_by",
        "checked_at"
      ],
      "properties": {
        "retention_terms_checked": {
          "const": true
        },
        "training_use_checked": {
          "const": true
        },
        "data_processing_agreement_checked": {
          "const": true
        },
        "checked_by": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"
        }
      }
    },
    "approved_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_type",
        "reviewer_id"
      ],
      "properties": {
        "reviewer_type": {
          "const": "human"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"
    },
    "allowed_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "description": "Exact modelnamen die onder dit record mogen worden gebruikt (geen standaard)."
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "mac"
      ],
      "properties": {
        "alg": {
          "const": "HMAC-SHA256"
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "HMAC over het canonieke record (zonder dit veld) met de geheime sleutel van de menselijke goedkeurder (omgeving, niet in de repository). Zonder geldige MAC weigert de veiligheidspoort."
    }
  }
}
