{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "building_link_record.schema.json",
  "title": "BuildingLinkStore",
  "description": "Append-only, door een mens bevestigde koppelingen historisch document <-> BAG-pand (docs/building_link_3dbag_evidence_v1.md). Eén ACTIVE record per (document_id, bag_pand_id); meerdere panden per document zijn meerdere records. Geen score- of confidencevelden.",
  "type": "object",
  "definitions": {
    "record": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string",
          "pattern": "^BLINK-[0-9]{5}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^DOC-[0-9]{3,}$"
        },
        "bag_pand_id": {
          "type": "string",
          "pattern": "^[0-9]{16}$"
        },
        "link_status": {
          "enum": [
            "CONFIRMED",
            "REJECTED"
          ]
        },
        "address_as_stated": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_address": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^BAGSNAP-[0-9a-f]{16}$"
            },
            "address_matches_containing_pand": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "address_provenance": {
              "type": [
                "object",
                "null"
              ]
            },
            "bag_properties": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "snapshot_id",
            "address_matches_containing_pand"
          ],
          "additionalProperties": false
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "reviewer_id": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_type": {
              "const": "human"
            }
          },
          "required": [
            "reviewer_id",
            "reviewer_type"
          ],
          "additionalProperties": false
        },
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "input_hashes": {
          "type": "object",
          "properties": {
            "verified_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "snapshot_id": {
              "type": "string"
            },
            "candidates_report_sha256": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "verified_sha256",
            "snapshot_id"
          ]
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^BLINK-[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "REVIEW_REQUIRED"
          ]
        }
      },
      "required": [
        "link_id",
        "document_id",
        "bag_pand_id",
        "link_status",
        "address_as_stated",
        "normalized_address",
        "evidence",
        "decision_reason",
        "reviewer",
        "reviewed_at",
        "rule_version",
        "input_hashes",
        "supersedes",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "store_version": {
      "const": "building_link_v1"
    },
    "description": {
      "type": "string"
    },
    "append_only": {
      "const": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "required": [
    "store_version",
    "append_only",
    "records"
  ],
  "additionalProperties": false
}
