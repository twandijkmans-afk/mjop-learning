{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unresolved_case_record.schema.json",
  "title": "BuildingProjectUnresolvedStore",
  "description": "Compacte unresolved-case records voor niet-goedgekeurde building_project-kandidaten: geen selected_scope, geen link (docs/building_projects_v1.md).",
  "type": "object",
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_key",
        "document_ids",
        "candidate_id",
        "case_status",
        "candidate_status",
        "candidate_strength",
        "selected_scope",
        "building_project_linked",
        "legal_vve_linked",
        "hypotheses",
        "open_points",
        "decisions_needed",
        "note",
        "provenance",
        "recorded_by",
        "recorded_at",
        "decision_source",
        "decision_reason",
        "rule_version",
        "supersedes",
        "status"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^UCASE-[0-9]{5}$"
        },
        "case_key": {
          "type": "string"
        },
        "document_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          }
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^BPC-"
        },
        "case_status": {
          "const": "REVIEW_REQUIRED"
        },
        "candidate_status": {
          "const": "CANDIDATE_UNREVIEWED"
        },
        "candidate_strength": {
          "type": "string"
        },
        "selected_scope": {
          "const": null
        },
        "building_project_linked": {
          "const": false
        },
        "legal_vve_linked": {
          "const": false
        },
        "hypotheses": {
          "type": "object"
        },
        "open_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "point_id",
              "statement",
              "evidence"
            ]
          }
        },
        "decisions_needed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "required": [
            "validation_dir",
            "candidate_package",
            "manifest",
            "raw_response_count"
          ],
          "properties": {
            "validation_dir": {
              "type": "string"
            },
            "raw_response_count": {
              "type": "integer"
            },
            "candidate_package": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "candidate_id",
                "run_id"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "manifest": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "run_id"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "recorded_by": {
          "type": "object",
          "required": [
            "recorder_id",
            "recorder_type"
          ],
          "properties": {
            "recorder_type": {
              "const": "claude_code"
            }
          }
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "decision_source": {
          "type": "string"
        },
        "decision_reason": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^UCASE-[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "REVIEW_REQUIRED"
          ]
        }
      }
    }
  },
  "properties": {
    "store_version": {
      "const": "building_project_unresolved_v1"
    },
    "description": {
      "type": "string"
    },
    "append_only": {
      "const": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "required": [
    "store_version",
    "append_only",
    "records"
  ],
  "additionalProperties": false
}
