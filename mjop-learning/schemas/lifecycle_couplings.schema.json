{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lifecycle_couplings.schema.json",
  "title": "LifecycleCouplings",
  "description": "Koppelingenregister (scripts/mjop_couplings.py). SAMEN: bij elke ingreep van de leider; ELKE_N: bij elke n-de; MEESCHUIVEN: eigen levensduur, verschoven naar een leiderjaar binnen max_shift_years; VERSCHOVEN: offset_years na de leider, ritme van de leider.",
  "type": "object",
  "definitions": {
    "spec": {
      "type": "object",
      "properties": {
        "element_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "element_code",
        "action"
      ],
      "additionalProperties": false
    },
    "leader": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "element_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "action": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "element_code",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "group": {
              "type": "string"
            }
          },
          "required": [
            "group"
          ],
          "additionalProperties": false
        }
      ]
    },
    "hv": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "by",
        "at",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "couplings_version": {
      "const": "lifecycle_couplings_v1"
    },
    "description": {
      "type": "string"
    },
    "max_shift_years": {
      "type": "integer",
      "minimum": 0
    },
    "max_shift_note": {
      "type": "string"
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label_nl": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/spec"
            }
          }
        },
        "required": [
          "label_nl",
          "members"
        ],
        "additionalProperties": false
      }
    },
    "couplings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label_nl": {
            "type": "string"
          },
          "follower": {
            "$ref": "#/definitions/spec"
          },
          "leader": {
            "$ref": "#/definitions/leader"
          },
          "type": {
            "enum": [
              "SAMEN",
              "ELKE_N",
              "MEESCHUIVEN",
              "VERSCHOVEN"
            ]
          },
          "offset_years": {
            "type": [
              "integer",
              "null"
            ]
          },
          "every_n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 2
          },
          "human_verification": {
            "$ref": "#/definitions/hv"
          }
        },
        "required": [
          "id",
          "label_nl",
          "follower",
          "leader",
          "type",
          "offset_years",
          "every_n",
          "human_verification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "couplings_version",
    "description",
    "max_shift_years",
    "groups",
    "couplings"
  ],
  "additionalProperties": true
}
