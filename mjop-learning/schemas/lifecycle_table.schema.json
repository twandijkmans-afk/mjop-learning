{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lifecycle_table.schema.json",
  "title": "LifecycleTable",
  "description": "Levensduurtabel per elementcode + actie (scripts/mjop_lifecycle.py, docs/mjop_actualisatie_light_v1.md). 'observed' is deterministisch afgeleid uit herhaalde posten in eigen geverifieerde MJOP's; een cyclus is pas effectief na een menselijke beslissing (ACCEPT/EDIT). Geen VvE-specifieke inhoud: alleen document-IDs en intervallen.",
  "type": "object",
  "definitions": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "observation": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string" },
        "element_id": { "type": "string" },
        "years": { "type": "array", "items": { "type": "integer" } },
        "intervals": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      },
      "required": ["document_id", "element_id", "years", "intervals"],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "element_code": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "label_nl": { "type": ["string", "null"] },
        "observed": {
          "type": "object",
          "properties": {
            "n_documents": { "type": "integer", "minimum": 0 },
            "n_intervals": { "type": "integer", "minimum": 0 },
            "n_single_occurrence": { "type": "integer", "minimum": 0 },
            "interval_min": { "type": ["integer", "null"] },
            "interval_median": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.5)?$" },
            "interval_max": { "type": ["integer", "null"] },
            "max_observable_interval": { "type": ["integer", "null"], "description": "Langste planperiode (laatste - eerste planjaar) van de bron-documenten: langere cycli zijn niet waarneembaar." },
            "proposed_cycle_years": { "type": ["integer", "null"], "minimum": 1, "description": "Alleen gevuld als de mediaan een geheel getal is; anders null (niet afronden)." },
            "observations": { "type": "array", "items": { "$ref": "#/definitions/observation" } }
          },
          "required": ["n_documents", "n_intervals", "n_single_occurrence", "interval_min", "interval_median",
                       "interval_max", "max_observable_interval", "proposed_cycle_years", "observations"],
          "additionalProperties": false
        },
        "cycle_years": { "type": ["integer", "null"], "minimum": 1, "description": "Effectieve cyclus; alleen na ACCEPT/EDIT." },
        "human_verification": {
          "type": ["object", "null"],
          "properties": {
            "decision": { "type": "string", "enum": ["ACCEPT", "EDIT", "REJECT"] },
            "original_proposed_value": { "type": ["integer", "null"] },
            "value": { "type": ["integer", "null"] },
            "by": { "type": "string", "minLength": 1 },
            "at": { "$ref": "#/definitions/timestamp" },
            "note": { "type": ["string", "null"] }
          },
          "required": ["decision", "original_proposed_value", "value", "by", "at", "note"],
          "additionalProperties": false
        }
      },
      "required": ["element_code", "action", "label_nl", "observed", "cycle_years", "human_verification"],
      "additionalProperties": false
    }
  },
  "properties": {
    "table_version": { "type": "string", "const": "lifecycle_table_v1" },
    "generated_at": { "$ref": "#/definitions/timestamp" },
    "source_documents": { "type": "array", "items": { "type": "string" } },
    "skipped": {
      "type": "object",
      "properties": {
        "groups_without_element_code": { "type": "integer", "minimum": 0 },
        "groups_without_action": { "type": "integer", "minimum": 0 }
      },
      "required": ["groups_without_element_code", "groups_without_action"],
      "additionalProperties": false
    },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "required": ["table_version", "generated_at", "source_documents", "skipped", "entries"],
  "additionalProperties": false
}
