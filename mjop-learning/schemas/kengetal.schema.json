{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kengetal.schema.json",
  "title": "KengetallenCollection",
  "description": "Output van scripts/build_kengetallen.py volgens docs/kengetallen_rules_v1.md: kengetallen uit volledig menselijk beoordeelde vergelijkbare groepen. Een kengetal is historisch, niet geïndexeerd, geen marktprijs en geen normprijs. Geen score-, confidence- of rankingvelden. Bedragen zijn Decimal-strings.",
  "type": "object",
  "definitions": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "decimal_or_null": { "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observation_id": { "type": "string", "pattern": "^PO-DOC-[0-9]{3,}-(P[0-9]{3}-L[0-9]{3}|S[0-9]{2}-R[0-9]{4})$" },
    "element_line": {
      "type": ["object", "null"],
      "properties": { "page": { "type": "integer" }, "line": { "type": "integer" } },
      "required": ["page", "line"],
      "additionalProperties": false
    },
    "post": {
      "type": "object",
      "properties": {
        "post_id": { "type": "string" },
        "source_cluster": { "type": "string" },
        "document_id": { "type": "string" },
        "observation_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/observation_id" } },
        "element_line": { "$ref": "#/definitions/element_line" },
        "consolidated": { "type": "boolean" },
        "consolidation_reason": { "type": ["string", "null"] },
        "post_value_exact": { "$ref": "#/definitions/decimal" }
      },
      "required": ["post_id", "source_cluster", "document_id", "observation_ids", "element_line", "consolidated",
                   "consolidation_reason", "post_value_exact"],
      "additionalProperties": false
    },
    "cluster_contribution": {
      "type": "object",
      "properties": {
        "source_cluster": { "type": "string" },
        "contribution_exact": { "$ref": "#/definitions/decimal" },
        "contribution_display": { "$ref": "#/definitions/decimal" },
        "post_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "observation_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/observation_id" } },
        "price_levels": { "type": "array", "items": { "type": ["string", "null"] } }
      },
      "required": ["source_cluster", "contribution_exact", "contribution_display", "post_ids", "observation_ids", "price_levels"],
      "additionalProperties": false
    },
    "source_reference": {
      "type": "object",
      "properties": {
        "observation_id": { "$ref": "#/definitions/observation_id" },
        "document_id": { "type": "string" },
        "source_cluster": { "type": "string" },
        "post_id": { "type": ["string", "null"] },
        "page": { "type": "integer" },
        "line": { "type": "integer" },
        "element_line": { "$ref": "#/definitions/element_line" },
        "source_text": { "type": "string" },
        "object_description": { "type": ["string", "null"] },
        "action_text": { "type": "string" },
        "quantity": { "$ref": "#/definitions/decimal_or_null" },
        "unit_original": { "type": ["string", "null"] },
        "price_per_execution_exact": { "$ref": "#/definitions/decimal_or_null" },
        "price_per_execution_display": { "$ref": "#/definitions/decimal_or_null" },
        "executions_in_window": { "type": ["integer", "null"] },
        "cycle_start_year": { "type": ["integer", "null"] },
        "cycle_length_years": { "type": ["integer", "null"] },
        "price_level_date": { "type": ["string", "null"] },
        "vat_basis": { "type": ["string", "null"] },
        "material": { "type": "object" },
        "independent_input": { "type": "boolean" },
        "caveats": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["observation_id", "document_id", "source_cluster", "post_id", "page", "line", "element_line",
                   "source_text", "action_text", "quantity", "price_per_execution_exact", "cycle_start_year",
                   "cycle_length_years", "price_level_date", "material", "independent_input", "caveats"],
      "additionalProperties": false
    },
    "kengetal": {
      "type": "object",
      "properties": {
        "kengetal_id": { "type": "string", "pattern": "^KG-" },
        "candidate_key": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": ["string", "null"] } },
        "element_code": { "type": ["string", "null"] },
        "action": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "material": {
          "type": "object",
          "properties": { "original": { "type": ["string", "null"] }, "normalized": { "type": ["string", "null"] } },
          "required": ["original", "normalized"],
          "additionalProperties": false
        },
        "material_source": { "type": "array", "items": { "type": ["string", "null"] } },
        "vat_basis": { "type": "array", "items": { "type": ["string", "null"] } },
        "status": { "type": "string", "enum": ["AVAILABLE", "INSUFFICIENT_DATA"] },
        "insufficient_data_reasons": { "type": "array", "items": { "type": "string" } },
        "value_exact": { "$ref": "#/definitions/decimal_or_null" },
        "value_display": { "$ref": "#/definitions/decimal_or_null" },
        "min_exact": { "$ref": "#/definitions/decimal_or_null" },
        "max_exact": { "$ref": "#/definitions/decimal_or_null" },
        "range_exact": { "$ref": "#/definitions/decimal_or_null" },
        "min_display": { "$ref": "#/definitions/decimal_or_null" },
        "max_display": { "$ref": "#/definitions/decimal_or_null" },
        "range_display": { "$ref": "#/definitions/decimal_or_null" },
        "calculation_method": { "type": "string" },
        "source_cluster_ids": { "type": "array", "items": { "type": "string" } },
        "source_cluster_count": { "type": "integer", "minimum": 0 },
        "cluster_contributions": { "type": "array", "items": { "$ref": "#/definitions/cluster_contribution" } },
        "posts": { "type": "array", "items": { "$ref": "#/definitions/post" } },
        "observation_ids": { "type": "array", "items": { "$ref": "#/definitions/observation_id" } },
        "observations_per_cluster": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/observation_id" } } },
        "excluded_observation_ids": { "type": "array", "items": { "$ref": "#/definitions/observation_id" } },
        "exclusion_reasons": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 } },
        "decision_ids": { "type": "array", "items": { "type": "string", "pattern": "^HDR-[0-9]{5}$" } },
        "human_review_complete": { "type": "boolean" },
        "missing_cross_cluster_reviews": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/observation_id" } } },
        "rule_version": { "type": "string", "const": "kengetallen_rules_v1" },
        "price_levels": {
          "type": "object",
          "properties": {
            "per_observation": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
            "per_cluster": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["string", "null"] } } },
            "years": { "type": "array", "items": { "type": "integer" } },
            "mixed_price_level": { "type": "boolean" },
            "missing_price_level": { "type": "boolean" },
            "indexation": { "type": "string", "const": "none" },
            "presentation_note": { "type": "string" }
          },
          "required": ["per_observation", "per_cluster", "years", "mixed_price_level", "missing_price_level", "indexation", "presentation_note"],
          "additionalProperties": false
        },
        "decision_caveats": {
          "type": "object",
          "properties": {
            "by_decision": { "type": "array", "items": { "type": "object" } },
            "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
          },
          "required": ["by_decision", "counts"],
          "additionalProperties": false
        },
        "observation_caveats": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "quantity": {
          "type": "object",
          "properties": {
            "min": { "$ref": "#/definitions/decimal_or_null" },
            "max": { "$ref": "#/definitions/decimal_or_null" },
            "max_min_ratio": { "$ref": "#/definitions/decimal_or_null" },
            "note": { "type": "string" }
          },
          "required": ["min", "max", "max_min_ratio", "note"],
          "additionalProperties": false
        },
        "source_references": { "type": "array", "items": { "$ref": "#/definitions/source_reference" } }
      },
      "required": ["kengetal_id", "candidate_key", "element_code", "action", "unit", "material", "material_source",
                   "status", "insufficient_data_reasons", "value_exact", "value_display", "min_exact", "max_exact",
                   "range_exact", "calculation_method", "source_cluster_ids", "source_cluster_count",
                   "cluster_contributions", "posts", "observation_ids", "observations_per_cluster",
                   "excluded_observation_ids", "exclusion_reasons", "decision_ids", "human_review_complete",
                   "rule_version", "price_levels", "decision_caveats", "observation_caveats", "quantity",
                   "source_references"],
      "additionalProperties": false
    }
  },
  "properties": {
    "rules_version": { "type": "string", "const": "kengetallen_rules_v1" },
    "rules_document": { "type": "string" },
    "comparability_rules_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "inputs": {
      "type": "object",
      "properties": {
        "normalized_observations_sha256": { "$ref": "#/definitions/sha256" },
        "comparability_output_sha256": { "$ref": "#/definitions/sha256" },
        "human_decisions_sha256": { "$ref": "#/definitions/sha256" },
        "rules_document_sha256": { "$ref": "#/definitions/sha256" }
      },
      "required": ["normalized_observations_sha256", "comparability_output_sha256", "human_decisions_sha256", "rules_document_sha256"],
      "additionalProperties": false
    },
    "supersedes": {
      "type": ["object", "null"],
      "properties": { "file": { "type": "string" }, "sha256": { "$ref": "#/definitions/sha256" } },
      "required": ["file", "sha256"],
      "additionalProperties": false
    },
    "note": { "type": "string" },
    "summary": { "type": "object" },
    "kengetallen": { "type": "array", "items": { "$ref": "#/definitions/kengetal" } }
  },
  "required": ["rules_version", "rules_document", "comparability_rules_version", "generated_at", "inputs", "supersedes",
               "note", "summary", "kengetallen"],
  "additionalProperties": false
}
