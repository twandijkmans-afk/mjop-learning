{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bruto_maintenance_request_v2.schema.json",
  "title": "BrutoMaintenanceRequestV2",
  "description": "Verzoeken om onderhoudshoeveelheidsvoorstellen. Een verzoek is geen besluit en bevat geen prijs of kengetal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "requests"
  ],
  "properties": {
    "contract_version": {
      "const": "bruto_maintenance_request_v2"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_type",
          "object_ids",
          "door_treatment",
          "measurement_basis",
          "basis_source_ref"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^MQ-[A-Z0-9][A-Z0-9-]*$"
          },
          "action_type": {
            "enum": [
              "EXTERIOR_PAINTING",
              "INTERIOR_PAINTING",
              "FRAME_MAINTENANCE",
              "FRAME_REPLACEMENT",
              "DOOR_MAINTENANCE",
              "DOOR_REPLACEMENT"
            ]
          },
          "object_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^BQO-[A-Z0-9][A-Z0-9-]*$"
            }
          },
          "door_treatment": {
            "enum": [
              "PART_OF_GROSS_FRAME_AREA",
              "AS_PIECES",
              "NOT_RELEVANT",
              "UNDECIDED"
            ]
          },
          "measurement_basis": {
            "enum": [
              null,
              "GROSS_FRAME_AREA_OUTER",
              "DOOR_PIECES",
              "HISTORICAL_SOURCE_BASIS"
            ]
          },
          "basis_source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
