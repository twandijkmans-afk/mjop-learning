{
  "$id": "human_instance_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Gesloten schema. Invoer = INPUT_KEYS; opgeslagen record = invoer + registerveld(en). Semantische controles (live aanvraag, hash, bewijs, duplicaten) staan in scripts/human_instance_decision_register.py en zijn niet in JSON Schema uit te drukken.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "acknowledged_open_app_ids": {
          "items": {
            "pattern": "^APP-\\d{3}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "acknowledged_open_relations": {
          "items": {
            "pattern": "^VR-\\d{3}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "approval_request_id": {
          "pattern": "^IAR-OIC-",
          "type": "string"
        },
        "candidate_group_id": {
          "pattern": "^OIC-",
          "type": "string"
        },
        "covers_levels": {
          "const": [
            "A"
          ]
        },
        "decided_by": {
          "minLength": 1,
          "type": "string"
        },
        "decision": {
          "enum": [
            "APPROVE_PHYSICAL_IDENTITY",
            "REJECT",
            "NEEDS_MORE_EVIDENCE"
          ]
        },
        "decision_provenance": {
          "additionalProperties": false,
          "properties": {
            "ai_authored_decision": {
              "const": false
            },
            "channel": {
              "enum": [
                "CLAUDE_CODE_CHAT",
                "CHATGPT_CONVERSATION",
                "HTML_FORM_EXPORT",
                "FILE_EDITED_BY_HUMAN"
              ]
            },
            "entered_by_kind": {
              "enum": [
                "HUMAN_DIRECT",
                "AI_TRANSCRIPTION_OF_HUMAN_MESSAGE"
              ]
            },
            "identity_verification": {
              "const": "NONE_SELF_ASSERTED",
              "description": "Er is geen cryptografische verificatie van de persoon."
            },
            "source_message_ref": {
              "minLength": 3,
              "type": "string"
            },
            "source_message_text": {
              "description": "Letterlijke verklaring van de mens; noemt aanvraag-id, request_hash en gekozen besluit.",
              "minLength": 60,
              "type": "string"
            }
          },
          "required": [
            "channel",
            "entered_by_kind",
            "source_message_ref",
            "source_message_text",
            "identity_verification",
            "ai_authored_decision"
          ],
          "type": "object"
        },
        "decision_source": {
          "enum": [
            "HUMAN",
            "HUMAN_CHAT_CONFIRMATION"
          ]
        },
        "decision_timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "evidence_reviewed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "record_version": {
          "const": 1
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "reviewer_notes": {
          "type": "string"
        }
      },
      "required": [
        "approval_request_id",
        "request_hash",
        "candidate_group_id",
        "decision",
        "covers_levels",
        "decision_source",
        "decided_by",
        "decision_provenance",
        "decision_timestamp",
        "acknowledged_open_app_ids",
        "acknowledged_open_relations",
        "evidence_reviewed",
        "reviewer_notes",
        "record_version"
      ],
      "title": "input",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "acknowledged_open_app_ids": {
          "items": {
            "pattern": "^APP-\\d{3}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "acknowledged_open_relations": {
          "items": {
            "pattern": "^VR-\\d{3}$",
            "type": "string"
          },
          "type": "array",
