          "type": "integer"
        }
      },
      "required": [
        "approval_request_id",
        "request_hash",
        "candidate_group_id",
        "decision",
        "covers_levels",
        "decision_source",
        "decided_by",
        "decision_provenance",
        "decision_timestamp",
        "acknowledged_open_app_ids",
        "acknowledged_open_relations",
        "evidence_reviewed",
        "reviewer_notes",
        "record_version",
        "decision_id",
        "sequence",
        "previous_record_hash",
        "record_hash",
        "register_version"
      ],
      "title": "stored",
      "type": "object"
    }
  ],
  "title": "Menselijk niveau-A-besluit over fysieke objectidentiteit (invoer en opgeslagen record)"
}
