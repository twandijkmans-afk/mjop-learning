          },
          "type": "array",
          "uniqueItems": true
        },
        "previous_record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "record_version": {
          "const": 1
        },
        "register_version": {
          "const": "human_instance_decision_register_v1"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "reviewer_notes": {
          "type": "string"
        },
        "sequence": {
