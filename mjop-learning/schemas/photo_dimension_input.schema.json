{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "photo_dimension_input.schema.json",
  "title": "PhotoDimensionInput",
  "description": "Gevalideerde buitenmaten per kozijntype plus de toewijzing van foto-observaties aan een type. Maten komen UITSLUITEND uit een gevalideerde referentiemaat, een betrouwbare bouwtekening of menselijke invoer; er is bewust geen bronsoort voor een AI-schatting. Een type-toewijzing is menselijk of volgt uit een goedgekeurde zelfde-type-relatie.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "photo_id", "dimension_references", "type_assignments"],
  "properties": {
    "contract_version": {"const": "photo_dimension_input_v1"},
    "photo_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "dimension_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_ref_id", "type_group_key", "element_type", "outer_width_m", "outer_height_m", "dimension_basis", "source"],
        "properties": {
          "dimension_ref_id": {"type": "string", "pattern": "^DIM-[0-9]{3}$"},
          "type_group_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,40}$"},
          "element_type": {"enum": ["WINDOW_OPENING", "EXTERIOR_DOOR", "BALCONY_DOOR"]},
          "outer_width_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$", "description": "Decimal-string in meters, buitenmaat kozijn."},
          "outer_height_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"},
          "dimension_basis": {"const": "OUTER_FRAME"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "validated_by", "validated_at"],
            "properties": {
              "kind": {"enum": ["VALIDATED_REFERENCE_MEASURE", "BUILDING_DRAWING", "HUMAN_INPUT"]},
              "reference": {"type": "string", "minLength": 1, "maxLength": 200},
              "validated_by": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reviewer_type", "reviewer_id"],
                "properties": {"reviewer_type": {"const": "human"}, "reviewer_id": {"type": "string", "minLength": 1}}
              },
              "validated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"}
            }
          }
        }
      }
    },
    "type_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "type_group_key", "basis", "assigned_by"],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^PO-[0-9]{3}$"},
          "type_group_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,40}$"},
          "basis": {"enum": ["HUMAN_ASSIGNED", "APPROVED_SAME_TYPE_RELATION"]},
          "assigned_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer_type", "reviewer_id"],
            "properties": {"reviewer_type": {"const": "human"}, "reviewer_id": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
